{{!
    @template mod_peerreview/review_card_body

    The inside of one review card: picture, name, status and the action label.

    Context variables required for this template:
    * name - Reviewee name
    * picture - Rendered user picture
    * statuslabel - Status text
    * statusclass - CSS classes for the status badge
    * actionlabel - Action text, empty when there is no action

    Example context (json):
    {
        "name": "Bo Chen",
        "picture": "<span class=\"userpicture\"></span>",
        "statuslabel": "Draft saved",
        "statusclass": "bg-warning text-dark",
        "actionlabel": "Continue review"
    }
}}
<div class="card-body d-flex align-items-center gap-3">
    <span class="mod_peerreview-card-picture flex-shrink-0">{{{picture}}}</span>
    <span class="flex-grow-1">
        <span class="mod_peerreview-card-name d-block fw-bold">{{name}}</span>
        <span class="badge {{statusclass}}">{{statuslabel}}</span>
    </span>
    {{#actionlabel}}<span class="mod_peerreview-card-action btn btn-primary" aria-hidden="true">{{actionlabel}}</span>{{/actionlabel}}
</div>
