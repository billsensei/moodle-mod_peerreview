{{!
    @template mod_peerreview/report_table

    The teacher progress table. The mod_peerreview/progress AMD module refreshes the cells of every row
    (found by data-region and data-userid) and the status line.

    Context variables required for this template:
    * cmid, groupid, interval, autorefresh, maxgrade - Settings for the live refresh
    * hasrows, rows - Rows: userid, name, url, given, received, grade, overridden, participation

    Example context (json):
    {
        "cmid": 5,
        "groupid": 0,
        "interval": 15,
        "autorefresh": true,
        "maxgrade": 100,
        "hasrows": true,
        "rows": [
            {"userid": 7, "name": "Ann Lee", "url": "https://example.org/mod/peerreview/report.php?id=5&user=7", "given": "1 / 2", "received": "2 / 2", "grade": "80.00", "overridden": false, "participation": "50%"}
        ]
    }
}}
<div data-region="peerreview-report" data-cmid="{{cmid}}" data-groupid="{{groupid}}" data-interval="{{interval}}">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="mod_peerreview_autorefresh" data-action="toggle-refresh" {{#autorefresh}}checked{{/autorefresh}}>
            <label class="form-check-label" for="mod_peerreview_autorefresh">{{#str}} autorefresh, mod_peerreview, {{interval}} {{/str}}</label>
        </div>
        <button type="button" class="btn btn-secondary" data-action="refresh-now">{{#str}} refreshnow, mod_peerreview {{/str}}</button>
        <span class="text-muted small" data-region="peerreview-status" role="status" aria-live="polite"></span>
    </div>
    {{#hasrows}}
    <div class="table-responsive">
        <table class="table table-striped generaltable mod_peerreview-report">
            <thead>
                <tr>
                    <th scope="col">{{#str}} student, mod_peerreview {{/str}}</th>
                    <th scope="col">{{#str}} reviewsgivencol, mod_peerreview {{/str}}</th>
                    <th scope="col">{{#str}} reviewsreceivedcol, mod_peerreview {{/str}}</th>
                    <th scope="col">{{#str}} receivedgrade, mod_peerreview {{/str}}</th>
                    <th scope="col">{{#str}} participation, mod_peerreview {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr data-region="peerreview-row" data-userid="{{userid}}">
                    <th scope="row"><a href="{{{url}}}">{{name}}</a></th>
                    <td data-field="given">{{given}}</td>
                    <td data-field="received">{{received}}</td>
                    <td data-field="grade">{{grade}}</td>
                    <td data-field="participation">{{participation}}</td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}
    <p class="text-muted">{{#str}} nostudentsshown, mod_peerreview {{/str}}</p>
    {{/hasrows}}
</div>
