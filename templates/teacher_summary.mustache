{{!
    @template mod_peerreview/teacher_summary

    The teacher summary on the activity page: counts, links and the feedback release switch.

    Context variables required for this template:
    * students, allocations, submitted, percent - Figures
    * progresstext, statusreleased - Texts
    * noallocations - True when nobody is allocated yet
    * hasreport, reporturl, hasallocate, allocateurl, hasrelease, releasebutton - Links and rendered button

    Example context (json):
    {
        "students": 24,
        "allocations": 48,
        "submitted": 12,
        "percent": 25,
        "progresstext": "12 of 48 reviews done",
        "statusreleased": "Feedback is hidden from students.",
        "noallocations": false,
        "hasreport": true,
        "reporturl": "https://example.org/mod/peerreview/report.php?id=5",
        "hasallocate": true,
        "allocateurl": "https://example.org/mod/peerreview/allocate.php?id=5",
        "hasrelease": true,
        "releasebutton": "<button type=\"submit\" class=\"btn btn-primary\">Release feedback</button>"
    }
}}
<div class="mod_peerreview-teacher">
    {{#noallocations}}
    <div class="alert alert-warning" role="status">{{#str}} noallocationsyet, mod_peerreview {{/str}}</div>
    {{/noallocations}}
    <p id="mod_peerreview-teacher-progress" class="mb-1">{{progresstext}}</p>
    <progress class="mod_peerreview-progress mb-3" max="100" value="{{percent}}" aria-labelledby="mod_peerreview-teacher-progress"></progress>
    <p>{{#str}} teachersummary, mod_peerreview, {{students}} {{/str}}</p>
    <p role="status">{{statusreleased}}</p>
    <div class="d-flex flex-wrap gap-2 align-items-start">
        {{#hasreport}}<a class="btn btn-primary" href="{{{reporturl}}}">{{#str}} report, mod_peerreview {{/str}}</a>{{/hasreport}}
        {{#hasallocate}}<a class="btn btn-secondary" href="{{{allocateurl}}}">{{#str}} allocate, mod_peerreview {{/str}}</a>{{/hasallocate}}
        {{#hasrelease}}{{{releasebutton}}}{{/hasrelease}}
    </div>
</div>
