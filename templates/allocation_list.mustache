{{!
    @template mod_peerreview/allocation_list

    The current allocations with a checkbox per row to delete them.

    Context variables required for this template:
    * actionurl - Form action URL
    * cmid - Course module id
    * sesskey - Session key
    * hasrows - Whether there are allocations
    * count - Number of allocations
    * rows - Array of allocations: id, reviewer, reviewee, label, status, started

    Example context (json):
    {
        "actionurl": "https://example.org/mod/peerreview/allocate.php",
        "cmid": 5,
        "sesskey": "abc123",
        "hasrows": true,
        "count": 2,
        "rows": [
            {"id": 1, "reviewer": "Ann Lee", "reviewee": "Bo Chen", "label": "Delete Ann Lee reviewing Bo Chen", "status": "Not started", "started": false},
            {"id": 2, "reviewer": "Bo Chen", "reviewee": "Ann Lee", "label": "Delete Bo Chen reviewing Ann Lee", "status": "Submitted", "started": true}
        ]
    }
}}
{{#hasrows}}
<form method="post" action="{{{actionurl}}}" class="mod_peerreview-allocations">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="id" value="{{cmid}}">
    <input type="hidden" name="method" value="delete">
    <p>{{#str}} allocationcount, mod_peerreview, {{count}} {{/str}}</p>
    <div class="table-responsive">
        <table class="table table-striped generaltable">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">{{#str}} select {{/str}}</span></th>
                    <th scope="col">{{#str}} reviewer, mod_peerreview {{/str}}</th>
                    <th scope="col">{{#str}} reviewee, mod_peerreview {{/str}}</th>
                    <th scope="col">{{#str}} status, mod_peerreview {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <td>
                        <input type="checkbox" name="delete[]" value="{{id}}" id="mod_peerreview_del_{{id}}">
                        <label for="mod_peerreview_del_{{id}}" class="visually-hidden">{{label}}</label>
                    </td>
                    <td>{{reviewer}}</td>
                    <td>{{reviewee}}</td>
                    <td>{{status}}</td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    <button type="submit" class="btn btn-secondary">{{#str}} deleteselected, mod_peerreview {{/str}}</button>
</form>
{{/hasrows}}
{{^hasrows}}
<p class="text-muted">{{#str}} noallocations, mod_peerreview {{/str}}</p>
{{/hasrows}}
