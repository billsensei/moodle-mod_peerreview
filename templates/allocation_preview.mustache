{{!
    @template mod_peerreview/allocation_preview

    Preview of an automatic allocation: warnings, per-student totals, confirm and back buttons.

    Context variables required for this template:
    * newcount - Pairs to be created
    * deletecount - Not-started pairs to be removed ("replace")
    * keptstarted - Started reviews kept
    * haskeptstarted, hasdeletes, canconfirm, haswarnings - Flags
    * spread - Largest difference in reviews received between students
    * warnings - Array of text
    * rows - Array: name, gives, givesnew, receives, receivesnew
    * confirmbutton, backbutton - Rendered buttons

    Example context (json):
    {
        "newcount": 4,
        "deletecount": 0,
        "keptstarted": 0,
        "haskeptstarted": false,
        "hasdeletes": false,
        "canconfirm": true,
        "haswarnings": true,
        "spread": 0,
        "warnings": [{"text": "Only 2 reviews per student are possible in a group of 3."}],
        "rows": [
            {"name": "Ann Lee", "gives": 2, "givesnew": 2, "receives": 2, "receivesnew": 2}
        ],
        "confirmbutton": "<button type=\"submit\" class=\"btn btn-primary\">Confirm</button>",
        "backbutton": "<button type=\"submit\" class=\"btn btn-secondary\">Change settings</button>"
    }
}}
{{#haswarnings}}
<div class="alert alert-warning" role="alert">
    <ul class="mb-0">
        {{#warnings}}<li>{{text}}</li>{{/warnings}}
    </ul>
</div>
{{/haswarnings}}
<p>{{#str}} previewsummary, mod_peerreview, { "new": "{{newcount}}", "spread": "{{spread}}" } {{/str}}</p>
{{#hasdeletes}}
<div class="alert alert-info" role="status">{{#str}} previewdeletes, mod_peerreview, {{deletecount}} {{/str}}</div>
{{/hasdeletes}}
{{#haskeptstarted}}
<div class="alert alert-info" role="status">{{#str}} previewkeptstarted, mod_peerreview, {{keptstarted}} {{/str}}</div>
{{/haskeptstarted}}
<div class="table-responsive">
    <table class="table table-striped generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} student, mod_peerreview {{/str}}</th>
                <th scope="col">{{#str}} reviewsgiven, mod_peerreview {{/str}}</th>
                <th scope="col">{{#str}} reviewsreceived, mod_peerreview {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <th scope="row">{{name}}</th>
                <td>{{gives}}{{#givesnew}} <span class="badge bg-success">+{{givesnew}}</span>{{/givesnew}}</td>
                <td>{{receives}}{{#receivesnew}} <span class="badge bg-success">+{{receivesnew}}</span>{{/receivesnew}}</td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
<div class="d-flex flex-wrap gap-2">
    {{#canconfirm}}{{{confirmbutton}}}{{/canconfirm}}
    {{{backbutton}}}
</div>
